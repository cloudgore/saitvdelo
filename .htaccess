Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Apply canonical redirects only to the production domain.
RewriteCond %{HTTP_HOST} ^(?:www\.)?saitvdelo\.ru$ [NC]
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ https://saitvdelo.ru/$1 [R=301,L]

RewriteCond %{HTTP_HOST} ^www\.saitvdelo\.ru$ [NC]
RewriteRule ^ https://saitvdelo.ru%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_mime.c>
AddType image/jpeg .jpg .jpeg
AddType font/woff2 .woff2
AddType application/xml .xml
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 365 days"
</IfModule>
